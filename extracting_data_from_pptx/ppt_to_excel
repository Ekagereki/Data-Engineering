import glob
import os
import re
import sys
from pathlib import Path
from openpyxl import Workbook
from openpyxl.styles import Font
from pptx import Presentation
from pptx.enum.shapes import MSO_SHAPE_TYPE


def safe_sheet_name(name: str, used: set) -> str:
    """Excel sheet names: max 31 chars, no  : \\ / ? * [ ]  and must be unique."""
    name = re.sub(r"[:\\/?*\[\]]", "_", name).strip("'") or "Sheet"
    name = name[:31]
    base, i = name, 1
    while name.lower() in used:
        suffix = f"_{i}"
        name = base[: 31 - len(suffix)] + suffix
        i += 1
    used.add(name.lower())
    return name


def iter_tables(shapes):
    """Yield every table in a collection of shapes (also digs into groups)."""
    for shape in shapes:
        if shape.shape_type == MSO_SHAPE_TYPE.GROUP:
            yield from iter_tables(shape.shapes)
        elif getattr(shape, "has_table", False) and shape.has_table:
            yield shape.table


def table_to_rows(table):
    """Convert a pptx table into a list of rows (list of strings)."""
    return [
        [cell.text.strip() for cell in row.cells]
        for row in table.rows
    ]

def pptx_tables_to_excel(folder=None, output_file="pptx_tables.xlsx"):
    """
    Load every .pptx in `folder`, extract all tables and write them to an Excel
    workbook with one sheet per pptx file.
    Returns the path of the Excel file (or None if no pptx files were found).
    """
    folder = Path(folder) if folder else Path(__file__).resolve().parent

    pptx_files = sorted(
        f for f in glob.glob(os.path.join(str(folder), "*.pptx"))
        if not os.path.basename(f).startswith("~$")
    )
    if not pptx_files:
        print(f"No .pptx files found in: {folder}")
        return None

    wb = Workbook()
    wb.remove(wb.active)
    used_names = set()
    bold = Font(bold=True)

    for pptx_path in pptx_files:
        pptx_name = Path(pptx_path).stem
        print(f"Reading {Path(pptx_path).name} ...")

        try:
            prs = Presentation(pptx_path)
        except Exception as exc:
            print(f"Could not open ({exc}) - skipped")
            continue

        ws = wb.create_sheet(safe_sheet_name(pptx_name, used_names))
        row_ptr = 1
        n_tables = 0

        for slide_no, slide in enumerate(prs.slides, start=1):
            for t_no, table in enumerate(iter_tables(slide.shapes), start=1):
                rows = table_to_rows(table)
                if not rows:
                    continue
                n_tables += 1

                # label row so you know where each table came from
                ws.cell(row=row_ptr, column=1,
                        value=f"Slide {slide_no} - Table {t_no}").font = bold
                row_ptr += 1

                for r_idx, row in enumerate(rows):
                    for c_idx, value in enumerate(row, start=1):
                        cell = ws.cell(row=row_ptr, column=c_idx, value=value)
                        if r_idx == 0:             # header row of the table
                            cell.font = bold
                    row_ptr += 1

                row_ptr += 1

        if n_tables == 0:
            ws.cell(row=1, column=1, value="No tables found in this file")
        print(f"  {n_tables} table(s) extracted")

        # tidy column widths
        for col in ws.columns:
            longest = max((len(str(c.value)) for c in col if c.value), default=8)
            ws.column_dimensions[col[0].column_letter].width = min(longest + 2, 60)

    if not wb.sheetnames:
        print("Nothing to save.")
        return None

    out_path = os.path.join(str(folder), output_file)
    wb.save(out_path)
    print(f"\nSaved: {out_path}")
    return out_path


if __name__ == "__main__":
    folder_arg = sys.argv[1] if len(sys.argv) > 1 else None
    output_arg = sys.argv[2] if len(sys.argv) > 2 else "pptx_tables.xlsx"
    pptx_tables_to_excel(folder_arg, output_arg)
