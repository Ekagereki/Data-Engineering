import argparse
import json
import logging
import os
import re
import sys
import time
from pathlib import Path

import pyodbc
import requests
from dotenv import load_dotenv


load_dotenv(dotenv_path=Path(__file__).resolve().parent / ".env")

logging.basicConfig(level=logging.INFO, format="%(asctime)s  %(levelname)-8s  %(message)s", datefmt="%Y-%m-%d %H:%M:%S")
log = logging.getLogger(__name__)

KOBO_BASE_URL = (os.getenv("KOBO_BASE_URL") or "https://kf.kobotoolbox.org").rstrip("/")
KOBO_TOKEN = os.getenv("KOBO_TOKEN")

COUCH_URL = os.getenv("COUCH_URL")
COUCH_USER = os.getenv("COUCH_USER")
COUCH_PASS = os.getenv("COUCH_PASS")

BATCH_SIZE = int(os.getenv("BATCH_SIZE", 500))
WATCH_POLL_S = int(os.getenv("WATCH_POLL_SECONDS", 300))
FAST_EXECUTEMANY = os.getenv("FAST_EXECUTEMANY", "false").strip().lower() in ("1", "true", "yes",)
CHANGES_PAGE = 500


def _odbc_escape(value: str) -> str:
    """Wrap a value in {} so ';' or '=' inside passwords don't break the string."""
    return "{" + (value or "").replace("}", "}}") + "}"


def _build_conn_str() -> str:
    conn_str = os.getenv("MSSQL_CONN_STR")
    if conn_str:
        return conn_str

    driver = os.getenv("DB_DRIVER", "SQL Server")
    server = os.getenv("DB_HOST", "localhost")
    port = os.getenv("DB_PORT", "1433")
    database = os.getenv("DB_NAME")
    user = os.getenv("DB_USER")
    password = os.getenv("DB_PASSWORD")

    server_address = f"{server},{port}" if port and port != "1433" else server

    parts = [f"DRIVER={{{driver}}}", f"SERVER={server_address}", f"DATABASE={database}"]
    if user:
        parts += [f"UID={user}", f"PWD={_odbc_escape(password)}"]
    else:
        parts.append("Trusted_Connection=yes")
    if "ODBC Driver" in driver:
        parts.append("TrustServerCertificate=yes")
    return ";".join(parts) + ";"


MSSQL_CONN_STR = _build_conn_str()
USE_FAST_EXECUTEMANY = FAST_EXECUTEMANY and "ODBC Driver" in MSSQL_CONN_STR

def safe_db_name(form_name: str) -> str:
    """CouchDB / SQL Server safe identifier (lowercase, letters, digits, underscore)."""
    name = form_name.lower().strip()
    name = re.sub(r"[^a-z0-9_]", "_", name)
    name = re.sub(r"_+", "_", name).strip("_")
    if name and name[0].isdigit():
        name = "form_" + name
    return (name or "kobo_form")[:63]


def chunks(items: list, size: int):
    for i in range(0, len(items), size):
        yield items[i : i + size]


def _http_error_detail(exc: requests.HTTPError) -> str:
    resp = exc.response
    if resp is None:
        return str(exc)
    return f"{exc} | body: {resp.text[:300]!r}"

def kobo_session() -> requests.Session:
    if not KOBO_TOKEN:
        log.error("KOBO_TOKEN is not set in .env")
        sys.exit(1)
    s = requests.Session()
    s.headers.update(
        {"Authorization": f"Token {KOBO_TOKEN}", "Accept": "application/json"}
    )
    return s


def get_all_forms(session: requests.Session) -> list[dict]:
    url = f"{KOBO_BASE_URL}/api/v2/assets/?asset_type=survey&format=json"
    forms: list[dict] = []
    while url:
        r = session.get(url, timeout=30)
        r.raise_for_status()
        data = r.json()
        forms.extend(data.get("results", []))
        url = data.get("next")

    deployed = [f for f in forms if f.get("has_deployment")]
    log.info(
        "KoboToolbox: found %d form(s), %d deployed (skipping %d draft/undeployed).",
        len(forms), len(deployed), len(forms) - len(deployed),
    )
    return deployed


def get_submissions(session: requests.Session, asset_uid: str) -> list[dict]:
    url = f"{KOBO_BASE_URL}/api/v2/assets/{asset_uid}/data/?format=json&limit={BATCH_SIZE}"
    rows: list[dict] = []
    while url:
        r = session.get(url, timeout=60)
        r.raise_for_status()
        data = r.json()
        rows.extend(data.get("results", []))
        url = data.get("next")
    return rows

class CouchDB:
    def __init__(self, base_url: str, user: str | None, password: str | None):
        if not base_url:
            log.error("COUCH_URL is missing or not set in .env")
            sys.exit(1)
        self.base = base_url.rstrip("/")
        self.session = requests.Session()
        if user and password:
            self.session.auth = (user, password)
        self.session.headers.update({"Content-Type": "application/json"})

    def _url(self, *parts) -> str:
        return "/".join([self.base] + [str(p).strip("/") for p in parts])

    def db_exists(self, db: str) -> bool:
        return self.session.head(self._url(db), timeout=30).status_code == 200

    def create_db(self, db: str) -> bool:
        r = self.session.put(self._url(db), timeout=30)
        if r.status_code == 201:
            log.info("  CouchDB: created database '%s'.", db)
            return True
        if r.status_code == 412:  # already exists
            return False
        r.raise_for_status()
        return False

    def all_dbs(self) -> list[str]:
        r = self.session.get(self._url("_all_dbs"), timeout=30)
        r.raise_for_status()
        return r.json()

    def _fetch_existing(self, db: str, ids: list[str]) -> dict[str, dict]:
        """Return {id: full doc} for existing docs; deleted docs return {'_rev': rev}."""
        if not ids:
            return {}
        r = self.session.post(
            self._url(db, "_all_docs"),
            data=json.dumps({"keys": ids}),
            params={"include_docs": "true"},
            timeout=60,
        )
        r.raise_for_status()
        existing: dict[str, dict] = {}
        for row in r.json().get("rows", []):
            if "error" in row:
                continue
            doc = row.get("doc")
            if doc:
                existing[row["id"]] = doc
            elif row.get("value", {}).get("rev"):  # deleted tombstone
                existing[row["id"]] = {"_rev": row["value"]["rev"]}
        return existing

    def bulk_upsert(self, db: str, docs: list[dict]) -> tuple[list[dict], int]:
        """Write only new/changed docs. Returns (bulk results, unchanged_count)."""
        existing = self._fetch_existing(db, [d["_id"] for d in docs])

        to_write: list[dict] = []
        unchanged = 0
        for doc in docs:
            old = existing.get(doc["_id"])
            if old is not None:
                if {k: v for k, v in old.items() if k != "_rev"} == doc:
                    unchanged += 1
                    continue
                doc["_rev"] = old["_rev"]
            to_write.append(doc)

        if not to_write:
            return [], unchanged

        r = self.session.post(
            self._url(db, "_bulk_docs"),
            data=json.dumps({"docs": to_write}),
            timeout=120,
        )
        r.raise_for_status()
        return r.json(), unchanged

    def changes(self, db: str, since: str = "0", limit: int = CHANGES_PAGE) -> dict:
        r = self.session.get(
            self._url(db, "_changes"),
            params={
                "since": since,
                "limit": limit,
                "include_docs": "true",
                "style": "main_only",
            },
            timeout=60,
        )
        r.raise_for_status()
        return r.json()


MSSQL_SETUP_SQL = """
IF NOT EXISTS (SELECT * FROM sys.tables WHERE name = '_couch_sync_state')
BEGIN
    CREATE TABLE _couch_sync_state (
        couch_db       NVARCHAR(255) PRIMARY KEY,
        last_seq       NVARCHAR(MAX) NOT NULL DEFAULT '0',
        last_synced_at DATETIMEOFFSET NOT NULL DEFAULT SYSDATETIMEOFFSET()
    );
END
"""

TABLE_SQL = """
IF NOT EXISTS (SELECT * FROM sys.tables WHERE name = '{table}')
BEGIN
    CREATE TABLE [{table}] (
        couch_id    NVARCHAR(255) PRIMARY KEY,
        couch_rev   NVARCHAR(255),
        form_uid    NVARCHAR(255),
        data        NVARCHAR(MAX) NOT NULL,
        imported_at DATETIMEOFFSET NOT NULL DEFAULT SYSDATETIMEOFFSET(),
        updated_at  DATETIMEOFFSET NOT NULL DEFAULT SYSDATETIMEOFFSET()
    );
END
"""

UPSERT_SQL = """
MERGE [{table}] AS target
USING (VALUES (?, ?, ?, ?)) AS source (couch_id, couch_rev, form_uid, data)
ON target.couch_id = source.couch_id
WHEN MATCHED THEN
    UPDATE SET
        target.couch_rev  = source.couch_rev,
        target.form_uid   = source.form_uid,
        target.data       = source.data,
        target.updated_at = SYSDATETIMEOFFSET()
WHEN NOT MATCHED THEN
    INSERT (couch_id, couch_rev, form_uid, data)
    VALUES (source.couch_id, source.couch_rev, source.form_uid, source.data);
"""

SYNC_STATE_UPSERT = """
MERGE _couch_sync_state AS target
USING (VALUES (?, ?)) AS source (couch_db, last_seq)
ON target.couch_db = source.couch_db
WHEN MATCHED THEN
    UPDATE SET
        target.last_seq       = source.last_seq,
        target.last_synced_at = SYSDATETIMEOFFSET()
WHEN NOT MATCHED THEN
    INSERT (couch_db, last_seq)
    VALUES (source.couch_db, source.last_seq);
"""


def mssql_connect() -> pyodbc.Connection:
    conn = pyodbc.connect(MSSQL_CONN_STR, autocommit=False)
    with conn.cursor() as cur:
        cur.execute(MSSQL_SETUP_SQL)
    conn.commit()
    log.info(
        "MS SQL Server: connected (fast_executemany=%s).", USE_FAST_EXECUTEMANY
    )
    return conn


def ensure_mssql_table(conn: pyodbc.Connection, table: str) -> None:
    with conn.cursor() as cur:
        cur.execute(TABLE_SQL.format(table=table))
    conn.commit()


def get_last_seq(conn: pyodbc.Connection, couch_db: str) -> str:
    with conn.cursor() as cur:
        cur.execute(
            "SELECT last_seq FROM _couch_sync_state WHERE couch_db = ?;",
            (couch_db,),
        )
        row = cur.fetchone()
    return row[0] if row else "0"


def save_last_seq(conn: pyodbc.Connection, couch_db: str, seq: str) -> None:
    with conn.cursor() as cur:
        cur.execute(SYNC_STATE_UPSERT, (couch_db, seq))
    conn.commit()


def upsert_rows(conn: pyodbc.Connection, table: str, rows: list[tuple]) -> None:
    sql = UPSERT_SQL.format(table=table)

    if USE_FAST_EXECUTEMANY:
        try:
            with conn.cursor() as cur:
                cur.fast_executemany = True
                cur.setinputsizes(
                    [
                        (pyodbc.SQL_WVARCHAR, 255, 0),  # couch_id
                        (pyodbc.SQL_WVARCHAR, 255, 0),  # couch_rev
                        (pyodbc.SQL_WVARCHAR, 255, 0),  # form_uid
                        (pyodbc.SQL_WVARCHAR, 0, 0),    # data -> NVARCHAR(MAX)
                    ]
                )
                cur.executemany(sql, rows)
            return
        except pyodbc.Error as exc:
            conn.rollback()
            log.warning("  fast_executemany failed (%s); retrying in normal mode.", exc)

    with conn.cursor() as cur:
        cur.executemany(sql, rows)


def sync_changes_to_mssql(
    couch: CouchDB,
    conn: pyodbc.Connection,
    couch_db: str,
    sql_table: str,
    form_uid: str,
    since: str | None = None,
) -> str:
    """Pull changes from CouchDB since *since* and upsert into MS SQL Server."""
    if since is None:
        since = get_last_seq(conn, couch_db)

    ensure_mssql_table(conn, sql_table)

    total_synced = 0
    last_seq = since

    while True:
        result = couch.changes(couch_db, since=last_seq, limit=CHANGES_PAGE)
        changes = result.get("results", [])
        last_seq = str(result.get("last_seq", last_seq))

        docs = [
            c["doc"]
            for c in changes
            if not c.get("deleted")
            and c.get("doc")
            and not c["id"].startswith("_design/")
        ]

        if docs:
            rows = [
                (
                    doc["_id"],
                    doc.get("_rev"),
                    form_uid,
                    json.dumps(doc, ensure_ascii=False),
                )
                for doc in docs
            ]
            upsert_rows(conn, sql_table, rows)
            conn.commit()
            total_synced += len(rows)

        if len(changes) < CHANGES_PAGE:
            break

    save_last_seq(conn, couch_db, last_seq)

    if total_synced:
        log.info(
            "  MS SQL Server: synced %d doc(s) into table '%s'.",
            total_synced, sql_table,
        )
    else:
        log.info("  MS SQL Server: '%s' already up to date.", sql_table)
    return last_seq


COUCH_RESERVED = {"_id", "_rev", "_deleted", "_attachments", "_conflicts"}


def submission_to_doc(sub: dict, uid: str, name: str) -> dict:
    doc: dict = {"_id": str(sub.get("_id") or sub.get("_uuid") or "")}
    for key, val in sub.items():
        if key in COUCH_RESERVED:
            continue
        # CouchDB rejects top-level keys starting with "_", so rename them
        doc["kobo" + key if key.startswith("_") else key] = val
    doc["kobo_form_uid"] = uid
    doc["kobo_form_name"] = name
    return doc


def export_form_to_couch(
    ksession: requests.Session,
    couch: CouchDB,
    form: dict,
) -> tuple[str, str] | None:
    """Export one form. Returns (couch_db, uid), or None if there is nothing to sync."""
    uid = form["uid"]
    name = form.get("name") or form.get("title") or uid

    # Suffix with the UID tail so forms with identical titles get distinct DBs
    db = f"{safe_db_name(name)[:56]}_{uid[-6:].lower()}"
    log.info("Form: '%s'  uid=%s  → '%s'", name[:80], uid, db)

    def fallback() -> tuple[str, str] | None:
        # If the DB already exists from an earlier run, still let it sync to SQL
        return (db, uid) if couch.db_exists(db) else None

    try:
        submissions = get_submissions(ksession, uid)
    except requests.HTTPError as exc:
        log.warning("  Skipping — KoboToolbox API error: %s", _http_error_detail(exc))
        return fallback()
    except requests.RequestException as exc:
        log.warning("  Skipping — network error: %s", exc)
        return fallback()

    if not submissions:
        log.info("  No submissions.")
        return fallback()

    couch.create_db(db)
    log.info("  Fetched %d submission(s) from KoboToolbox.", len(submissions))

    docs = [submission_to_doc(s, uid, name) for s in submissions]
    docs = [d for d in docs if d["_id"]]

    written = unchanged = 0
    errors: list[dict] = []
    for batch in chunks(docs, BATCH_SIZE):
        results, same = couch.bulk_upsert(db, batch)
        unchanged += same
        written += sum(1 for r in results if r.get("ok"))
        errors += [r for r in results if "error" in r]

    log.info(
        "CouchDB: %d written, %d unchanged, %d errors.",
        written, unchanged, len(errors),
    )
    for e in errors[:5]:
        log.warning("    %s", e)

    return db, uid


def export_all(
    ksession: requests.Session, couch: CouchDB, forms: list[dict]
) -> dict[str, str]:
    db_uid_map: dict[str, str] = {}
    for form in forms:
        try:
            result = export_form_to_couch(ksession, couch, form)
        except Exception as exc:  # one bad form must not stop the rest
            log.error("Export failed for form %s: %s", form.get("uid"), exc)
            continue
        if result:
            db_name, uid = result
            db_uid_map[db_name] = uid
    return db_uid_map


def sync_all(
    couch: CouchDB, conn: pyodbc.Connection, db_uid_map: dict[str, str]
) -> int:
    """Sync every DB to SQL Server. Returns the number of failures."""
    failures = 0
    for couch_db, form_uid in db_uid_map.items():
        log.info("── Sync: %s", couch_db)
        try:
            sync_changes_to_mssql(couch, conn, couch_db, couch_db, form_uid)
        except (requests.RequestException, pyodbc.Error) as exc:
            failures += 1
            log.error("  Sync failed for '%s': %s", couch_db, exc)
            try:
                conn.rollback()
            except pyodbc.Error:
                pass
    return failures

def main() -> int:
    parser = argparse.ArgumentParser(
        description="KoboToolbox → CouchDB → MS SQL Server pipeline."
    )
    parser.add_argument("--form-id", metavar="UID",
                        help="Export a single form by its KoboToolbox asset UID.")
    parser.add_argument("--sync-only", action="store_true",
                        help="Skip KoboToolbox; only sync existing CouchDB DBs → MS SQL Server.")
    parser.add_argument("--watch", action="store_true",
                        help="Repeat the whole pipeline every WATCH_POLL_SECONDS.")
    args = parser.parse_args()

    couch = CouchDB(COUCH_URL, COUCH_USER, COUCH_PASS)
    conn = mssql_connect()

    ksession = None
    forms: list[dict] = []

    if not args.sync_only:
        ksession = kobo_session()
        if args.form_id:
            r = ksession.get(
                f"{KOBO_BASE_URL}/api/v2/assets/{args.form_id}/?format=json",
                timeout=30,
            )
            r.raise_for_status()
            forms = [r.json()]
        else:
            forms = get_all_forms(ksession)
        if not forms:
            log.warning("No deployed forms found. Exiting.")
            conn.close()
            return 0

    def run_cycle() -> int:
        if args.sync_only:
            dbs = [d for d in couch.all_dbs() if not d.startswith("_")]
            log.info("Sync-only mode: found %d CouchDB database(s).", len(dbs))
            db_uid_map = {d: d for d in dbs}
        else:
            db_uid_map = export_all(ksession, couch, forms)

        log.info("Syncing %d database(s) to MS SQL Server …", len(db_uid_map))
        return sync_all(couch, conn, db_uid_map)

    failures = run_cycle()

    if args.watch:
        log.info("Watch mode: repeating every %ds. Press Ctrl+C to stop.", WATCH_POLL_S)
        try:
            while True:
                time.sleep(WATCH_POLL_S)
                log.info("Poll cycle …")
                failures = run_cycle()
        except KeyboardInterrupt:
            log.info("Watch stopped.")

    conn.close()
    log.info("Done%s.", f" ({failures} database(s) failed to sync)" if failures else "")
    return 1 if failures else 0


if __name__ == "__main__":
    sys.exit(main())
